#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# PacBio demultiplex status
#
# Usage:
#
#   cd <run>/1_A01/hifi_reads
#   pacbio-demux2fastq-status
# ============================================================


WORKDIR="$(pwd)"


# ------------------------------------------------------------
# Require hifi_reads
# ------------------------------------------------------------

if [[ "$(basename "$WORKDIR")" != "hifi_reads" ]]; then
    echo "ERROR:"
    echo "Run this command from a hifi_reads directory."
    echo
    echo "Current directory:"
    echo "  $WORKDIR"
    exit 1
fi


# ------------------------------------------------------------
# Identify run
# ------------------------------------------------------------

RUN_DIR="$(basename "$(dirname "$(dirname "$WORKDIR")")")"

SESSION="pacbio_${RUN_DIR//[^a-zA-Z0-9_-]/_}"

LOG="$WORKDIR/pacbio_demux.log"

STATUS_FILE="$WORKDIR/pacbio_demux.status"

RUNTIME_REPORT="$WORKDIR/pacbio_demux_runtime.txt"


echo "========================================"
echo "PacBio Demultiplex Status"
echo "========================================"
echo

echo "Run:"
echo "  $RUN_DIR"
echo


# ============================================================
# ACTIVE SESSION
# ============================================================

if tmux has-session -t "$SESSION" 2>/dev/null; then

    echo "Status:"
    echo "  RUNNING"
    echo

    echo "tmux:"
    echo "  $SESSION"
    echo

    echo "Latest output:"
    echo "----------------------------------------"

    tmux capture-pane \
        -pt "$SESSION" \
        -S -30

    echo "----------------------------------------"

    exit 0
fi


# ============================================================
# COMPLETED
# ============================================================

if [[ -f "$STATUS_FILE" ]] && \
   [[ "$(cat "$STATUS_FILE")" == "COMPLETED" ]] && \
   [[ -f "$RUNTIME_REPORT" ]]; then

    echo "Status:"
    echo "  COMPLETED"
    echo

    cat "$RUNTIME_REPORT"

    exit 0
fi


# ============================================================
# FAILED
# ============================================================

if [[ -f "$STATUS_FILE" ]] && \
   [[ "$(cat "$STATUS_FILE")" == "FAILED" ]]; then

    echo "Status:"
    echo "  FAILED"
    echo

    if [[ -f "$LOG" ]]; then

        echo "Latest log output:"
        echo "----------------------------------------"

        tail -40 "$LOG"

        echo "----------------------------------------"
        echo

        echo "Full log:"
        echo "  $LOG"

    fi

    exit 1
fi


# ============================================================
# COMPLETION REPORT EXISTS
#
# Fallback for older runs that do not have status file.
# ============================================================

if [[ -f "$RUNTIME_REPORT" ]]; then

    echo "Status:"
    echo "  COMPLETED"
    echo

    cat "$RUNTIME_REPORT"

    exit 0
fi


# ============================================================
# STOPPED / UNKNOWN
# ============================================================

if [[ -f "$LOG" ]]; then

    echo "Status:"
    echo "  STOPPED / UNKNOWN"
    echo

    echo "No active PacBio tmux session and no completion report."
    echo

    echo "Latest log output:"
    echo "----------------------------------------"

    tail -40 "$LOG"

    echo "----------------------------------------"
    echo

    echo "Full log:"
    echo "  $LOG"

    exit 1
fi


# ============================================================
# NOT STARTED
# ============================================================

echo "Status:"
echo "  NOT STARTED"
