#!/usr/bin/env bash

set -euo pipefail


# ============================================================
# FASTQ Import v1
# ============================================================
#
# Purpose:
#   Copy PacBio FASTQ.gz files from a source directory
#   (for example, mounted NAS / Vega output)
#   into an existing personal analysis workspace.
#
# Destination:
#
#   /home/adprc/workspaces/<OWNER>/<PROJECT>/fastq/
#
# Expected FASTQ naming:
#
#   <SampleID>.hifi_reads.fastq.gz
#
# Modes:
#
#   All FASTQ:
#     fastq-import --all SOURCE OWNER PROJECT
#
#   Selected Sample IDs:
#     fastq-import --list SAMPLE_LIST SOURCE OWNER PROJECT
#
# Safety:
#
#   - Source files are never deleted.
#   - Source files are never modified.
#   - rsync --delete is never used.
#   - Existing destination FASTQ files are not overwritten.
#   - The project must already exist.
#
# ============================================================


WORKSPACE_ROOT="/home/adprc/workspaces"

MODE=""
SAMPLE_LIST=""
SOURCE=""
OWNER=""
PROJECT=""


# ============================================================
# Helper functions
# ============================================================

usage() {
    cat <<'EOF'

FASTQ Import
============

Copy PacBio FASTQ.gz files into an existing analysis workspace.


USAGE
-----

Import all FASTQ files:

  fastq-import --all SOURCE OWNER PROJECT


Import selected Sample IDs:

  fastq-import --list SAMPLE_LIST SOURCE OWNER PROJECT


Show help:

  fastq-import --help


EXAMPLES
--------

Import all FASTQ files:

  fastq-import --all \
    "/home/vega_output/r21201_20260820_071510/1_A01/hifi_reads/fastq" \
    Bing \
    kmuh_CRC


Import selected Sample IDs:

  fastq-import --list samples.txt \
    "/home/vega_output/r21201_20260820_071510/1_A01/hifi_reads/fastq" \
    Bing \
    kmuh_CRC


Paths containing spaces are supported:

  fastq-import --all \
    "/home/vega_output/PacBio Run 20260820/fastq" \
    "Bing Wu" \
    "CRC Analysis 2026"


SAMPLE LIST FORMAT
------------------

One Sample ID per line:

  CRC001
  CRC003
  CRC017
  CRC105


Blank lines are allowed.

Comments beginning with # are allowed:

  # CRC samples
  CRC001
  CRC003

  # Additional samples
  CRC017


Do NOT include the FASTQ suffix.

Correct:

  CRC001

Incorrect:

  CRC001.hifi_reads.fastq.gz


CRC001 automatically matches:

  CRC001.hifi_reads.fastq.gz


Sample IDs must not contain whitespace.


DESTINATION
-----------

FASTQ files are copied to:

  /home/adprc/workspaces/<OWNER>/<PROJECT>/fastq/


The OWNER and PROJECT directories must already exist.

If the project exists but fastq/ does not exist,
fastq/ will be created automatically.


SAFETY
------

  - Source files are never deleted.
  - Source files are never modified.
  - rsync --delete is never used.
  - Existing FASTQ files are not overwritten.
  - Missing requested Sample IDs stop the import before copying.
  - Unknown projects are not automatically created.

EOF
}


die() {
    echo >&2
    echo "ERROR: $*" >&2
    echo >&2
    exit 1
}


format_duration() {
    local seconds="$1"

    printf '%02d:%02d:%02d' \
        $((seconds / 3600)) \
        $(((seconds % 3600) / 60)) \
        $((seconds % 60))
}


# ============================================================
# Parse arguments
# ============================================================

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi


case "$1" in

    --all)

        MODE="all"

        if [[ $# -ne 4 ]]; then
            usage
            exit 1
        fi

        SOURCE="$2"
        OWNER="$3"
        PROJECT="$4"
        ;;


    --list)

        MODE="list"

        if [[ $# -ne 5 ]]; then
            usage
            exit 1
        fi

        SAMPLE_LIST="$2"
        SOURCE="$3"
        OWNER="$4"
        PROJECT="$5"
        ;;


    -h|--help)

        usage
        exit 0
        ;;


    *)

        die "Unknown option: $1"
        ;;

esac


# ============================================================
# Check dependencies
# ============================================================

command -v rsync >/dev/null 2>&1 ||
    die "rsync is not installed."

command -v gzip >/dev/null 2>&1 ||
    die "gzip is not installed."

command -v stat >/dev/null 2>&1 ||
    die "stat is not available."

command -v find >/dev/null 2>&1 ||
    die "find is not available."


# ============================================================
# Validate source directory
# ============================================================

[[ -d "$SOURCE" ]] ||
    die "Source directory does not exist: $SOURCE"


SOURCE="$(
    cd "$SOURCE" &&
    pwd -P
)"


# ============================================================
# Validate owner / project
# ============================================================
#
# Spaces are allowed.
#
# "/" is forbidden because OWNER and PROJECT each represent
# exactly one directory level.
#
# ============================================================

[[ -n "$OWNER" ]] ||
    die "Owner name cannot be empty."

[[ -n "$PROJECT" ]] ||
    die "Project name cannot be empty."


[[ "$OWNER" != *"/"* ]] ||
    die "Owner name cannot contain '/': $OWNER"

[[ "$PROJECT" != *"/"* ]] ||
    die "Project name cannot contain '/': $PROJECT"


[[ "$OWNER" != "." && "$OWNER" != ".." ]] ||
    die "Invalid owner name: $OWNER"

[[ "$PROJECT" != "." && "$PROJECT" != ".." ]] ||
    die "Invalid project name: $PROJECT"


OWNER_DIR="${WORKSPACE_ROOT}/${OWNER}"
DEST_PROJECT="${OWNER_DIR}/${PROJECT}"
DEST_FASTQ="${DEST_PROJECT}/fastq"


# ============================================================
# Validate workspace
# ============================================================

[[ -d "$OWNER_DIR" ]] ||
    die "Workspace owner does not exist: $OWNER_DIR"


[[ -d "$DEST_PROJECT" ]] ||
    die "Project does not exist: $DEST_PROJECT"


# ============================================================
# Validate sample list
# ============================================================

if [[ "$MODE" == "list" ]]; then

    [[ -f "$SAMPLE_LIST" ]] ||
        die "Sample list does not exist: $SAMPLE_LIST"


    SAMPLE_LIST="$(
        cd "$(dirname "$SAMPLE_LIST")" &&
        printf '%s/%s\n' "$PWD" "$(basename "$SAMPLE_LIST")"
    )"

fi


# ============================================================
# Temporary working directory
# ============================================================

TMP_DIR="$(mktemp -d)"


cleanup() {
    rm -rf -- "$TMP_DIR"
}


trap cleanup EXIT


FILE_LIST="${TMP_DIR}/files.txt"

: > "$FILE_LIST"


# ============================================================
# Build FASTQ import list
# ============================================================

if [[ "$MODE" == "all" ]]; then

    # --------------------------------------------------------
    # ALL mode
    # --------------------------------------------------------

    while IFS= read -r -d '' file; do
        basename "$file"
    done < <(
        find "$SOURCE" \
            -maxdepth 1 \
            -type f \
            -name "*.hifi_reads.fastq.gz" \
            -print0
    ) | sort > "$FILE_LIST"


else

    # --------------------------------------------------------
    # LIST mode
    # --------------------------------------------------------

    declare -A SEEN_SAMPLES=()

    MISSING=0


    while IFS= read -r SAMPLE || [[ -n "$SAMPLE" ]]; do

        # Remove Windows CR if present.
        SAMPLE="${SAMPLE%$'\r'}"


        # Trim leading/trailing whitespace.
        SAMPLE="$(
            printf '%s' "$SAMPLE" |
            sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
        )"


        # Ignore blank lines.
        [[ -z "$SAMPLE" ]] && continue


        # Ignore comments.
        [[ "$SAMPLE" == \#* ]] && continue


        # ----------------------------------------------------
        # Validate Sample ID
        # ----------------------------------------------------

        if [[ "$SAMPLE" =~ [[:space:]] ]]; then
            die "Sample ID contains whitespace: '$SAMPLE'"
        fi


        if [[ "$SAMPLE" == *"/"* ]]; then
            die "Sample ID contains '/': '$SAMPLE'"
        fi


        if [[ "$SAMPLE" == "." || "$SAMPLE" == ".." ]]; then
            die "Invalid Sample ID: '$SAMPLE'"
        fi


        # ----------------------------------------------------
        # Ignore duplicate Sample IDs
        # ----------------------------------------------------

        if [[ -n "${SEEN_SAMPLES[$SAMPLE]+x}" ]]; then
            echo "WARNING: Duplicate Sample ID ignored: $SAMPLE"
            continue
        fi


        SEEN_SAMPLES["$SAMPLE"]=1


        # ----------------------------------------------------
        # Expected FASTQ filename
        # ----------------------------------------------------

        FASTQ_NAME="${SAMPLE}.hifi_reads.fastq.gz"


        # ----------------------------------------------------
        # Check source FASTQ
        # ----------------------------------------------------

        if [[ ! -f "${SOURCE}/${FASTQ_NAME}" ]]; then

            echo "MISSING: ${FASTQ_NAME}" >&2

            MISSING=$((MISSING + 1))

            continue

        fi


        printf '%s\n' "$FASTQ_NAME" >> "$FILE_LIST"


    done < "$SAMPLE_LIST"


    # --------------------------------------------------------
    # If any requested FASTQ is missing:
    # stop before copying anything.
    # --------------------------------------------------------

    if [[ "$MISSING" -gt 0 ]]; then
        die "$MISSING requested FASTQ file(s) were not found. Nothing was copied."
    fi

fi


# ============================================================
# Count selected FASTQ files
# ============================================================

FILE_COUNT="$(wc -l < "$FILE_LIST")"

FILE_COUNT="${FILE_COUNT//[[:space:]]/}"


[[ "$FILE_COUNT" -gt 0 ]] ||
    die "No FASTQ files selected for import."


# ============================================================
# Check destination conflicts
# ============================================================
#
# Existing destination FASTQ files are not overwritten.
#
# The destination fastq/ directory may not exist yet.
# That is OK.
#
# ============================================================

CONFLICT_COUNT=0


if [[ -d "$DEST_FASTQ" ]]; then

    while IFS= read -r FASTQ_NAME; do

        if [[ -e "${DEST_FASTQ}/${FASTQ_NAME}" ]]; then

            echo \
                "EXISTS: ${DEST_FASTQ}/${FASTQ_NAME}" \
                >&2

            CONFLICT_COUNT=$((CONFLICT_COUNT + 1))

        fi

    done < "$FILE_LIST"

fi


if [[ "$CONFLICT_COUNT" -gt 0 ]]; then

    die "$CONFLICT_COUNT destination FASTQ file(s) already exist. Existing files will not be overwritten."

fi


# ============================================================
# Calculate total source size
# ============================================================

TOTAL_BYTES=0


while IFS= read -r FASTQ_NAME; do

    SIZE="$(
        stat -c '%s' "${SOURCE}/${FASTQ_NAME}"
    )"

    TOTAL_BYTES=$((TOTAL_BYTES + SIZE))

done < "$FILE_LIST"


if command -v numfmt >/dev/null 2>&1; then

    TOTAL_HUMAN="$(
        numfmt \
            --to=iec-i \
            --suffix=B \
            "$TOTAL_BYTES"
    )"

else

    TOTAL_HUMAN="${TOTAL_BYTES} bytes"

fi


# ============================================================
# Import summary
# ============================================================

echo
echo "========================================"
echo "FASTQ Import"
echo "========================================"
echo


echo "Mode:"

if [[ "$MODE" == "all" ]]; then
    echo "  All FASTQ"
else
    echo "  Sample list"
fi


echo
echo "Source:"
echo "  $SOURCE"


echo
echo "Workspace owner:"
echo "  $OWNER"


echo
echo "Project:"
echo "  $PROJECT"


echo
echo "Destination:"
echo "  $DEST_FASTQ"


echo
echo "FASTQ files:"
echo "  $FILE_COUNT"


echo
echo "Total size:"
echo "  $TOTAL_HUMAN"


if [[ "$MODE" == "list" ]]; then

    echo
    echo "Sample list:"
    echo "  $SAMPLE_LIST"

fi


echo
echo "Source protection:"
echo "  READ / COPY ONLY"


echo
echo "Existing destination FASTQ:"
echo "  WILL NOT OVERWRITE"


echo


# ============================================================
# Create destination FASTQ directory
# ============================================================
#
# Project must already exist.
#
# Only fastq/ may be created automatically.
#
# ============================================================

mkdir -p "$DEST_FASTQ"


# ============================================================
# Timing
# ============================================================

START_TIME="$(date '+%Y-%m-%d %H:%M:%S')"

TOTAL_START="$(date +%s)"


# ============================================================
# rsync transfer
# ============================================================

echo "========================================"
echo "Starting rsync"
echo "========================================"
echo


TRANSFER_START="$(date +%s)"


rsync \
    -ah \
    --info=progress2 \
    --files-from="$FILE_LIST" \
    --ignore-existing \
    "${SOURCE}/" \
    "${DEST_FASTQ}/"


TRANSFER_END="$(date +%s)"

TRANSFER_SECONDS=$((TRANSFER_END - TRANSFER_START))


echo
echo "rsync completed."
echo


echo "Transfer runtime:"
echo "  $(format_duration "$TRANSFER_SECONDS")"


echo


# ============================================================
# FASTQ validation
# ============================================================

echo "========================================"
echo "FASTQ validation"
echo "========================================"
echo


VALIDATION_START="$(date +%s)"

VALIDATED=0


while IFS= read -r FASTQ_NAME; do

    SOURCE_FILE="${SOURCE}/${FASTQ_NAME}"
    DEST_FILE="${DEST_FASTQ}/${FASTQ_NAME}"


    # --------------------------------------------------------
    # Destination must exist
    # --------------------------------------------------------

    [[ -f "$DEST_FILE" ]] ||
        die "Destination FASTQ missing after rsync: $DEST_FILE"


    # --------------------------------------------------------
    # Compare source and destination file sizes
    # --------------------------------------------------------

    SOURCE_SIZE="$(
        stat -c '%s' "$SOURCE_FILE"
    )"


    DEST_SIZE="$(
        stat -c '%s' "$DEST_FILE"
    )"


    if [[ "$SOURCE_SIZE" -ne "$DEST_SIZE" ]]; then
        die "File size mismatch: $FASTQ_NAME"
    fi


    # --------------------------------------------------------
    # Validate gzip integrity
    # --------------------------------------------------------

    if ! gzip -t "$DEST_FILE"; then
        die "gzip validation failed: $DEST_FILE"
    fi


    VALIDATED=$((VALIDATED + 1))


done < "$FILE_LIST"


VALIDATION_END="$(date +%s)"

VALIDATION_SECONDS=$((VALIDATION_END - VALIDATION_START))


echo
echo "Validated FASTQ files:"
echo "  $VALIDATED"


echo
echo "Validation runtime:"
echo "  $(format_duration "$VALIDATION_SECONDS")"


echo


# ============================================================
# Write import manifest
# ============================================================

MANIFEST="${DEST_FASTQ}/fastq_import_manifest.tsv"


{
    printf \
        'sample_id\tfastq\tsource\tdestination\tsize_bytes\n'


    while IFS= read -r FASTQ_NAME; do

        SAMPLE_ID="${FASTQ_NAME%.hifi_reads.fastq.gz}"


        SIZE="$(
            stat -c '%s' \
                "${DEST_FASTQ}/${FASTQ_NAME}"
        )"


        printf \
            '%s\t%s\t%s\t%s\t%s\n' \
            "$SAMPLE_ID" \
            "$FASTQ_NAME" \
            "${SOURCE}/${FASTQ_NAME}" \
            "${DEST_FASTQ}/${FASTQ_NAME}" \
            "$SIZE"


    done < "$FILE_LIST"


} > "$MANIFEST"


# ============================================================
# Completion
# ============================================================

TOTAL_END="$(date +%s)"

TOTAL_SECONDS=$((TOTAL_END - TOTAL_START))

END_TIME="$(date '+%Y-%m-%d %H:%M:%S')"


echo "========================================"
echo "FASTQ import completed successfully"
echo "========================================"
echo


echo "Start:"
echo "  $START_TIME"


echo
echo "End:"
echo "  $END_TIME"


echo
echo "Imported:"
echo "  $VALIDATED FASTQ files"


echo
echo "Destination:"
echo "  $DEST_FASTQ"


echo
echo "Manifest:"
echo "  $MANIFEST"


echo
echo "Runtime:"
echo "  Transfer:   $(format_duration "$TRANSFER_SECONDS")"
echo "  Validation: $(format_duration "$VALIDATION_SECONDS")"
echo "  Total:      $(format_duration "$TOTAL_SECONDS")"


echo
echo "NAS/source files:"
echo "  NOT MODIFIED"


echo
